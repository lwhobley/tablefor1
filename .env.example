# Public Supabase keys are safe to ship to the client.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: redirect URL used by magic links in dev and production.
EXPO_PUBLIC_AUTH_REDIRECT_URL=http://localhost:8081/auth/callback

# RevenueCat public iOS API key and entitlement identifier for Premium.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_revenuecat_public_ios_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
